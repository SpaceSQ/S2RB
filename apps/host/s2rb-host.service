[Unit]
Description=S2 Rainbow Bridge host
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=15
TimeoutStartSec=180
WorkingDirectory=/opt/s2rb/apps/host
EnvironmentFile=-/opt/s2rb/apps/host/.env
ExecStart=/opt/s2rb/apps/host/s2rb-host.sh start
ExecReload=/opt/s2rb/apps/host/s2rb-host.sh reload
ExecStop=/opt/s2rb/apps/host/s2rb-host.sh stop

[Install]
WantedBy=multi-user.target
